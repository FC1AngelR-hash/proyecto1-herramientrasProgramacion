	"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@clerk/clerk-js": "^6.31.1",
		"resend": "^6.26.0",
		"svelte-clerk": "^1.1.15",
		"three": "^0.180.0"
	}
}
