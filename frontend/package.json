{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
	"build": "cd src/frontend && npm install && npm run build",
    "start": "node src/backend/index.js",
	"dev": "vite dev",
	"build": "vite build",
	"preview": "vite preview",
	"prepare": "svelte-kit sync || echo ''",
